# Ollama Configuration
OLLAMA_CHAT_URL=http://0.0.0.0:11434/api/chat
MODEL_NAME=llama3.2:3b

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true
REDIS_SESSION_TTL=3600

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# API Configuration
API_TITLE=Math Tutor Service
API_VERSION=1.0.0

# RAG Configuration (Chroma + Ollama Embeddings)
RAG_ENABLED=true
RAG_DB_DIR=rag_db
RAG_DOCS_DIR=rag_docs
RAG_COLLECTION_NAME=math_tutor_rag
RAG_TOP_K=6
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT_CHARS=4000
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_AUTO_INGEST=false
RAG_BATCH_SIZE=32

# Ollama Embeddings
OLLAMA_EMBED_URL=http://0.0.0.0:11434/api/embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text
